PORT=3000
# Set NODE_ENV=development for local development.
# Local trip-flow testing before gateway setup: set CHAUFR_TEST_BYPASS_ACTIVATION=true with NODE_ENV=development only.
# This bypass is rejected outside development and must NEVER be enabled in production.
# Set DATABASE_URL to enable PostgreSQL-backed startup and automatic migrations.
# Example format only; never commit real credentials:
# DATABASE_URL=postgresql://chaufr_user:change-me@localhost:5432/chaufr
# For managed databases requiring TLS, set DB_SSL=true (certificate verification stays enabled).
# Generate a production key with: openssl rand -base64 32
# Keep this secret outside Git; never use the CI test key in production.
# VEHICLE_DATA_ENCRYPTION_KEY=replace-with-a-private-32-byte-base64-key
DB_SSL=false
FARE_RULE_VERSION=development-3
FARE_CURRENCY=ZAR
# Development-only placeholders. Replace with approved production values.
FARE_BASE=10
FARE_PER_KM=1
FARE_PER_MINUTE=0
FARE_OPERATING_PER_KM=2
FARE_COMMISSION_RATE=0.12
DAILY_ACTIVATION_FEE=30
FARE_MINIMUM=40
FARE_FUEL_PRICE_PER_LITRE=24.50
FARE_FUEL_STANDARD_L100KM=8
FARE_FUEL_COMFORT_L100KM=9
FARE_FUEL_XL_L100KM=11
FARE_STANDARD_MULTIPLIER=1
FARE_COMFORT_MULTIPLIER=1.15
FARE_XL_MULTIPLIER=1.30

# Server-side Google Routes API key (keep private; never use the Android-restricted key here).
# GOOGLE_MAPS_SERVER_API_KEY=replace-with-server-restricted-key
# Generate with: openssl rand -base64 32
# FARE_QUOTE_SIGNING_SECRET=replace-with-a-private-signing-secret

# Paystack South Africa. Use test credentials until merchant onboarding and sandbox tests are complete.
# PAYSTACK_SECRET_KEY=sk_test_replace-me
# Optional if Paystack sends timestamped Paystack-Signature headers.
# PAYSTACK_WEBHOOK_SECRET=whsec_replace-me
# PAYSTACK_CALLBACK_URL=https://your-domain.example/payment-return
# Generate two separate keys with: openssl rand -base64 32
# PAYOUT_DATA_ENCRYPTION_KEY=replace-with-a-private-32-byte-base64-key
# DOCUMENT_ENCRYPTION_KEY=replace-with-a-different-private-32-byte-base64-key

# Production-only provider configuration. Set only in the hosting secret manager.
# Generate each encryption key independently: openssl rand -base64 32
# VEHICLE_DATA_ENCRYPTION_KEY=...
# DOCUMENT_ENCRYPTION_KEY=...
# SMS_VERIFICATION_SECRET must be a random string of at least 32 bytes.
# SMS_VERIFICATION_SECRET=...
# Twilio sender must be a verified E.164 number (South Africa example format: +27...).
# TWILIO_ACCOUNT_SID=AC...
# TWILIO_AUTH_TOKEN=...
# TWILIO_FROM_NUMBER=+27...
# Firebase service-account JSON for the same Firebase project as both Android apps.
# FIREBASE_SERVICE_ACCOUNT_JSON={"project_id":"...","client_email":"...","private_key":"..."}
# Production startup refuses to run if required values are missing or malformed.
